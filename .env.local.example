# Copy to .env.local and set VITE_API_BASE to point at your environments-server.
# When this is set, the UI uses real HTTP — when unset, it falls back to mock data.
#
# Local development (environments-server running locally):
# VITE_API_BASE=http://localhost:8090
#
# In-cluster (port-forwarded):
# VITE_API_BASE=http://localhost:8090
#
# Leave unset to use mock data:
# VITE_API_BASE=
